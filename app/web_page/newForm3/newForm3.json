    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.registroDiario ){",
        "\treturn {",
        "\t\t//map registroDiario variable to expected task contract input",
        "\t\tregistroDiarioInput: {",
        "\t\t\tfechaRegistro: $data.registroDiario.fechaRegistro !== undefined ? $data.registroDiario.fechaRegistro : null,",
        "\t\t\tpeso: $data.registroDiario.peso !== undefined ? $data.registroDiario.peso : null,",
        "\t\t\ttensionArterial: $data.registroDiario.tensionArterial !== undefined ? $data.registroDiario.tensionArterial : null,",
        "\t\t\tintegridadOrificio: $data.registroDiario.integridadOrificio !== undefined ? $data.registroDiario.integridadOrificio : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
