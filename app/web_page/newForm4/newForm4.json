    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.registroDiario ){",
        "\treturn {",
        "\t\t//map registroDiario variable to expected task contract input",
        "\t\tregistroDiarioInput: {",
        "\t\t\thoraRegistro: $data.registroDiario.horaRegistro !== undefined ? $data.registroDiario.horaRegistro : null,",
        "\t\t\tultraFiltracion: $data.registroDiario.ultraFiltracion !== undefined ? $data.registroDiario.ultraFiltracion : null,",
        "\t\t\taspectoLiquido: $data.registroDiario.aspectoLiquido !== undefined ? $data.registroDiario.aspectoLiquido : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
